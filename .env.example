# Copy to `.env` and fill in. `.env` is gitignored — never commit it.

# Base URL of the API.
#
# Leave EMPTY for local development: the app derives the dev machine's LAN IP
# from Expo at runtime and points at the local json-server (`pnpm api`).
# Hardcoding `http://localhost:3000` here does not work on an Android emulator
# (localhost is the emulator itself) or on a physical device.
#
# Set this only to target a deployed API, e.g. https://api.foodio.example.com
EXPO_PUBLIC_API_URL=

# Google Maps SDK for Android key, read at build time by app.config.ts.
#
# Not a secret — it ships in the APK — but keep it out of git: this repo is
# public. Restrict it in the Cloud console to the Android package
# `com.hedonarc.foodio` plus your signing SHA-1, and to Maps SDK for Android
# only. Without it, the delivery-area map renders grey on Android.
GOOGLE_MAPS_API_KEY=
